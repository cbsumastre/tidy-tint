{
  "name": "tidy-tint",
  "displayName": "Tidy Tint",
  "description": "Color your VS Code window per workspace without reordering your settings.json",
  "version": "0.1.1",
  "publisher": "cbsumastre-es",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbsumastre/tidy-tint.git"
  },
  "bugs": {
    "url": "https://github.com/cbsumastre/tidy-tint/issues"
  },
  "homepage": "https://github.com/cbsumastre/tidy-tint#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2f6fd6",
    "theme": "dark"
  },
  "keywords": [
    "color",
    "workspace",
    "titlebar",
    "statusbar",
    "activitybar",
    "peacock",
    "settings"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tidyTint.changeColor",
        "title": "Change Color",
        "category": "Tidy Tint"
      },
      {
        "command": "tidyTint.randomColor",
        "title": "Random Color",
        "category": "Tidy Tint"
      },
      {
        "command": "tidyTint.removeColors",
        "title": "Remove Colors",
        "category": "Tidy Tint"
      }
    ],
    "configuration": {
      "title": "Tidy Tint",
      "properties": {
        "tidyTint.color": {
          "type": "string",
          "scope": "window",
          "description": "Current workspace color (managed by Tidy Tint)."
        },
        "tidyTint.affectActivityBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Color the Activity Bar."
        },
        "tidyTint.affectTitleBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Color the Title Bar."
        },
        "tidyTint.affectStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Color the Status Bar."
        },
        "tidyTint.favoriteColors": {
          "type": "array",
          "scope": "application",
          "description": "Favorite colors shown in the color picker.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "default": [
            {
              "name": "Tomato Red",
              "value": "#d63c3c"
            },
            {
              "name": "Orange",
              "value": "#e8772e"
            },
            {
              "name": "Yellow",
              "value": "#f2c94c"
            },
            {
              "name": "Green",
              "value": "#2e8b57"
            },
            {
              "name": "Teal",
              "value": "#1a9e9e"
            },
            {
              "name": "Blue",
              "value": "#2f6fd6"
            },
            {
              "name": "Purple",
              "value": "#7b4bc4"
            },
            {
              "name": "Pink",
              "value": "#c4417f"
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
